# SmartResume - Resume parsing system configuration fil

# Model configuration (used for default OpenAI client)
model:
  api_url: "api-place-holder"
  api_key: "your-api-key-here"

# Multi-channel configuration
channels:
  # Sample API channel
  api:
    name: "model-name-here"
    api_url: "api-place-holder"
    api_key: "your-api-key-here"
    max_tokens: 4096
    temperature: 0
    top_p: 1.0
    seed: 0

# Extraction type channel configuration
extract_channels:
  basic_info: "api"
  work_experience: "api"
  education: "api"

# Processing configuration
processing:
  # Force use OCR
  use_force_ocr: false
  
  # Force JSON format
  use_force_json: false
  
  # Use PDF raw text
  use_pdf_raw_text: false
  
  remove_position_and_company_line: false

  # OCR only the pages where it can add text (embedded pictures, text drawn as
  # outlines, no text layer). On an ordinary text PDF OCR finds nothing and only
  # costs time. false = OCR every page.
  skip_ocr_without_images: true

# Layout detection configuration
layout_detection:
  enabled: true

# Direct model configuration
use_direct_models: true
# Hugging Face repo id; downloaded to models/<name> (e.g. models/gemma-4-E4B-it) on first use
direct_model_name: "google/gemma-4-E4B-it"

# Direct model loading / generation
direct_model:
  # nf4  = 4-bit weights (bitsandbytes): ~4 GB VRAM, but all weights are unpacked on
  #        every forward pass, so each generated token is slower.
  # none = full precision: ~10 GB VRAM, fastest tokens, no quantization loss.
  # auto = none on GPUs with >= 14 GB VRAM (falls back to nf4 if it does not fit), else nf4.
  quantization: "nf4"
  compute_dtype: "float16"   # float16 | bfloat16 (try bfloat16 if outputs come back as NaN/garbage)
  # Gemma "E" models carry ~2.8B params of per-layer embedding tables that are only
  # looked up, never multiplied. Keeping them in system RAM saves ~5.6 GB of VRAM.
  offload_per_layer_embeddings: true
  max_new_tokens: 1024
  # Lower caps for extraction types whose answer is always short
  max_new_tokens_by_type:
    basic_info: 256
  # Share of VRAM PyTorch may use. Without a cap Windows spills into shared system
  # memory when VRAM is full and generation crawls. --gpu-memory GB overrides it.
  gpu_memory_fraction: 0.88

# Model download configuration
model_download:
  source: "huggingface"  # huggingface
  models_dir:
    llm: "models"       # Path for LLM models
    layout: "models"    # Path for layout detection models
  auto_download: true   # Auto-download models if not found

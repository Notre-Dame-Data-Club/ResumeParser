# SmartResume - Resume parsing system configuration fil

# Model configuration (used for default OpenAI client)
model:
  api_url: "api-place-holder"
  api_key: "your-api-key-here"

# Multi-channel configuration
channels:
  # Sample API channel
  api:
    name: "qwen-turbo"
    api_url: "api-place-holder"
    api_key: "your-api-key-here"
    max_tokens: 4096
    temperature: 0
    top_p: 1.0
    seed: 0

# Extraction type channel configuration
extract_channels:
  basic_info: "api"
  work_experience: "api"
  education: "api"

# Processing configuration
processing:
  # Force use OCR
  use_force_ocr: false
  
  # Force JSON format
  use_force_json: false
  
  # Use PDF raw text
  use_pdf_raw_text: false
  
  remove_position_and_company_line: false

# Layout detection configuration
layout_detection:
  enabled: true

# Direct model configuration
use_direct_models: true
direct_model_name: "models/Qwen3-0.6B"

# Model download configuration
model_download:
  source: "modelscope"  # modelscope
  models_dir:
    llm: "models"       # Path for LLM models
    layout: "models"    # Path for layout detection models
  auto_download: true   # Auto-download models if not found
